# Copy to .env and replace every placeholder. Never commit .env.
SECRET_KEY=replace-with-64-random-characters
MASTER_ENCRYPTION_KEY=replace-with-base64-32-random-bytes
LICENSE_SECRET=replace-with-random-characters
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
DATABASE_URL=sqlite:///./data.db
STORAGE_DIR=./storage
CORS_ORIGINS=https://launcher.example.com

# Cloudflare R2 (leave empty to stream zips from the VPS disk)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PRESIGNED_TTL=300
